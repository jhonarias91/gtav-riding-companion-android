<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Same policy as backup_rules.xml: pairing data is excluded from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/pairing.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/pairing.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
